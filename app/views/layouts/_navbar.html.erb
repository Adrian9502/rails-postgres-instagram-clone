<nav
  id="navbar"
  class="fixed top-0 left-0 w-full bg-white border-b border-gray-200 z-50 shadow-sm"
  style="height: 80px;"
>
  <div class="flex items-center justify-between h-full px-6 max-w-6xl mx-auto">
    <!-- Logo / Title -->
    <div class="logo shrink-0">
      <%=
        link_to 'Instagram',
                root_path,
                class: 'no-underline text-black text-3xl',
                style: "font-family: 'Billabong', cursive;"
      %>
    </div>

    <!-- Search (hidden on mobile) -->
    <div class="relative hidden md:block w-64">
      <i class="fa fa-search absolute top-2.5 left-3 text-gray-400 text-sm"></i>
      <input
        type="text"
        placeholder="Search"
        class="w-full bg-gray-100 pl-9 pr-4 py-2 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-500"
      />
    </div>

    <!-- Navigation -->
    <div class="flex items-center gap-4 md:gap-6">
      <% if user_signed_in? %>
        <!-- User Email + Profile Icon -->
        <div class="hidden md:flex items-center gap-2">
          <span class="text-sm text-gray-700 font-medium truncate max-w-35">
            <%= current_user.email %>
          </span>
          <%= link_to edit_user_registration_path, class: "text-black relative group" do %>
            <i class="far fa-user-circle text-xl"></i>
            <span
              class="absolute bottom-full left-1/2 -translate-x-1/2 px-2 py-1 text-xs text-white bg-gray-800 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none"
            >
              Profile
            </span>
          <% end %>
        </div>

        <!-- New Post -->
        <%= link_to new_post_path, class: "text-black relative group" do %>
          <i class="fas fa-plus-square text-xl"></i>
          <span
            class="absolute bottom-full left-1/2 -translate-x-1/2 px-2 py-1 text-xs text-white bg-gray-800 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none"
          >
            Create Post
          </span>
        <% end %>

        <!-- Logout -->
        <%= link_to destroy_user_session_path, method: :delete, class: "text-black relative group" do %>
          <i class="fas fa-sign-out-alt text-xl"></i>
          <span
            class="absolute bottom-full left-1/2 -translate-x-1/2 px-2 py-1 text-xs text-white bg-gray-800 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none"
          >
            Logout
          </span>
        <% end %>
      <% else %>
        <!-- Guest: Sign Up / Log In - Modern Design -->
        <%= link_to new_user_session_path, class: "group relative px-4 py-2 overflow-hidden rounded-lg transition-all duration-300 hover:shadow-md" do %>
          <span
            class="relative z-10 text-sm font-medium text-gray-700 group-hover:text-blue-600 transition-colors duration-300"
          >
            Log In
          </span>
        <% end %>

        <%= link_to new_user_registration_path, class: "group relative px-5 py-2 bg-gradient-to-r from-blue-500 to-purple-600 rounded-lg overflow-hidden transition-all duration-300 hover:shadow-lg hover:scale-105" do %>
          <span
            class="absolute inset-0 bg-linear-to-r from-purple-600 to-blue-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          ></span>
          <span class="relative z-10 text-sm font-semibold text-white">
            Sign Up
          </span>
        <% end %>
      <% end %>

      <!-- About Icon (always visible) -->
      <%= link_to home_about_path, class: "text-black relative group" do %>
        <i class="fas fa-info-circle text-xl"></i>
        <span
          class="absolute bottom-full left-1/2 -translate-x-1/2 px-2 py-1 text-xs text-white bg-gray-800 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none"
        >
          About
        </span>
      <% end %>
    </div>
  </div>
</nav>

<!-- Fonts + Icons -->
<link href="https://fonts.cdnfonts.com/css/billabong" rel="stylesheet" />
<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
/>

<%# !YT TIME 1:04:23 %>
