<%= form_with(model: post, class: "contents") do |form| %>
  <%# title form %>
  <%= render 'shared/form_field', form: form, object: post, field: :title %>
  <%# description form %>
  <%=
    render 'shared/form_field', form: form, object: post, field: :description
  %>
  <%# keywords form %>
  <%= render 'shared/form_field', form: form, object: post, field: :keywords %>
  <%# choose image form %>
  <div class="my-5">
    <label
      class="block w-full text-center rounded-md border border-gray-300 px-3 py-2 cursor-pointer hover:bg-gray-100 bg-white"
    >
      <span id="file-label" class="text-gray-700">Choose images</span>
      <%=
        form.file_field :images,
                        multiple: true,
                        direct_upload: true,
                        class: 'hidden',
                        id: 'post_images'
      %>
    </label>

    <!-- Preview container -->
    <div id="image-preview" class="mt-3 flex flex-row gap-3 flex-wrap"></div>
  </div>

  <div class="inline">
    <%=
      form.submit class:
                    'w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer'
    %>
  </div>
<% end %>

<style>
  #image-preview img {
    width: 96px !important;
    height: 96px !important;
    object-fit: cover !important;
    border-radius: 0.375rem !important;
    border: 2px solid #d1d5db !important;
  }

  #image-preview > div {
    flex-shrink: 0 !important;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fileInput = document.getElementById('post_images');
    const fileLabel = document.getElementById('file-label');
    const previewContainer = document.getElementById('image-preview');

    if (!fileInput) return;

    fileInput.addEventListener('change', (event) => {
      const files = Array.from(event.target.files);

      console.log('Files selected:', files.length);

      // Update label
      if (files.length === 0) {
        fileLabel.textContent = 'Choose images';
        previewContainer.innerHTML = '';
        return;
      } else if (files.length === 1) {
        fileLabel.textContent = files[0].name;
      } else {
        fileLabel.textContent = `${files.length} files selected`;
      }

      // Clear previous previews
      previewContainer.innerHTML = '';

      // Limit to first 3 images for preview
      const filesToPreview = files.slice(0, 3);

      filesToPreview.forEach((file, index) => {
        console.log('Processing file:', file.name, file.type);

        if (file.type.match('image.*')) {
          const reader = new FileReader();

          reader.onload = (e) => {
            const imgWrapper = document.createElement('div');

            const img = document.createElement('img');
            img.src = e.target.result;
            img.alt = file.name;

            imgWrapper.appendChild(img);
            previewContainer.appendChild(imgWrapper);
          };

          reader.readAsDataURL(file);
        }
      });

      // Show indicator if more than 3 files selected
      if (files.length > 3) {
        const moreIndicator = document.createElement('div');
        moreIndicator.style.cssText =
          'width: 96px; height: 96px; display: flex; align-items: center; justify-content: center; background-color: #f3f4f6; border-radius: 0.375rem; border: 2px solid #d1d5db; color: #4b5563; font-size: 1rem; font-weight: 600; flex-shrink: 0;';
        moreIndicator.textContent = `+${files.length - 3}`;
        previewContainer.appendChild(moreIndicator);
      }
    });
  });
</script>
