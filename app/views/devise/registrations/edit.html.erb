<% content_for :head do %>
  <style>
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    main {
      margin-top: 80px !important;
      min-height: calc(100vh - 80px) !important;
      padding: 2rem 1.25rem !important;
    }
  </style>
<% end %>

<div class="flex items-center justify-center w-full">
  <div
    class="w-full max-w-md bg-white border border-gray-200 rounded-lg shadow-sm p-8"
  >
    <!-- Logo / Title -->
    <div class="text-center mb-6">
      <div class="logo">
        <%=
          link_to 'Instagram',
                  root_path,
                  class: 'no-underline text-black text-3xl',
                  style: "font-family: 'Billabong', cursive;"
        %>
      </div>
      <p class="text-sm text-gray-500 mt-2">Edit your account</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
      <%= render 'devise/shared/error_messages', resource: resource %>

      <!-- Email -->
      <div>
        <%=
          f.email_field :email,
                        autofocus: true,
                        autocomplete: 'email',
                        placeholder: 'Email',
                        class:
                          'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-500'
        %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div
          class="bg-yellow-50 border border-yellow-200 text-yellow-700 px-4 py-3 rounded-md text-sm"
        >
          Currently waiting confirmation for: <%= resource.unconfirmed_email %>
        </div>
      <% end %>

      <!-- Password -->
      <div>
        <%=
          f.password_field :password,
                           autocomplete: 'new-password',
                           placeholder:
                             'New Password (leave blank to keep current)',
                           class:
                             'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-500'
        %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-500 mt-1">
            Minimum <%= @minimum_password_length %> characters
          </p>
        <% end %>
      </div>

      <!-- Password Confirmation -->
      <div>
        <%=
          f.password_field :password_confirmation,
                           autocomplete: 'new-password',
                           placeholder: 'Confirm New Password',
                           class:
                             'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-500'
        %>
      </div>

      <!-- Current Password -->
      <div>
        <%=
          f.password_field :current_password,
                           autocomplete: 'current-password',
                           placeholder:
                             'Current Password (required to save changes)',
                           class:
                             'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-500'
        %>
        <p class="text-xs text-gray-500 mt-1">
          We need your current password to confirm changes
        </p>
      </div>

      <!-- Submit -->
      <div>
        <%=
          f.submit 'Update Account',
                   class:
                     'w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 rounded-md transition'
        %>
      </div>
    <% end %>

    <!-- Divider -->
    <div class="relative my-6">
      <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-gray-200"></div>
      </div>
    </div>

    <!-- Show Delete Option Button -->
    <div class="text-center">
      <button
        id="showDeleteButton"
        onclick="toggleDeleteSection()"
        class="text-sm text-gray-500 hover:text-red-600 transition"
      >
        Other options
      </button>
    </div>

    <!-- Cancel Account Section (Hidden by default) -->
    <div id="deleteAccountSection" class="hidden mt-4">
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <h3 class="text-sm font-semibold text-red-800 mb-2">Delete Account</h3>
        <p class="text-xs text-red-600 mb-3">
          This action cannot be undone. All your posts and data will be
          permanently deleted.
        </p>
        <%=
          button_to 'Delete My Account',
                    registration_path(resource_name),
                    data: {
                      confirm: 'Are you sure? This action cannot be undone!',
                      turbo_confirm:
                        'Are you sure? This action cannot be undone!',
                    },
                    method: :delete,
                    class:
                      'w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-2 rounded-md transition text-sm'
        %>
      </div>
    </div>

    <!-- Back Link -->
    <div class="mt-6 text-center">
      <%=
        link_to 'Back',
                :back,
                class: 'text-sm text-blue-500 hover:text-blue-600 transition'
      %>
    </div>
  </div>
</div>

<script>
  function toggleDeleteSection() {
    const section = document.getElementById("deleteAccountSection");
    const button = document.getElementById("showDeleteButton");

    if (section.classList.contains("hidden")) {
      section.classList.remove("hidden");
      button.textContent = "Hide options";
      button.classList.add("text-red-600");
      button.classList.remove("text-gray-500");
    } else {
      section.classList.add("hidden");
      button.textContent = "Other options";
      button.classList.remove("text-red-600");
      button.classList.add("text-gray-500");
    }
  }
</script>
