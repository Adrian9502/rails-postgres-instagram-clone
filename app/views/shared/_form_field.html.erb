<% invalid = object.errors.include?(field) %>

<div class="my-5">
  <%= form.label field %>

  <%= form.text_field field,
    class: [
      "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full",
      {
        "border-gray-400 focus:outline-blue-600" => object.errors[field].none?,
        "border-red-400 focus:outline-red-600"   => object.errors[field].any?
      }
    ]
  %>

  <% if invalid %>
    <p class="text-red-600 text-sm mt-1">
      <%= object.errors.full_messages_for(field).join(", ") %>
    </p>
  <% end %>
</div>
