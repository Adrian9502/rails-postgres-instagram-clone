<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
  <div
    class="w-full max-w-sm bg-white border border-gray-200 rounded-lg shadow-sm p-8"
  >
    <!-- Logo / Title -->
    <div class="text-center mb-6">
      <div class="logo">
        <%=
          link_to 'Instagram',
                  root_path,
                  class: 'no-underline text-black text-3xl',
                  style: "font-family: 'Billabong', cursive;"
        %>
      </div>
      <p class="text-sm text-gray-500 mt-2">
        Sign up to see photos and videos from your friends
      </p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <%= render 'devise/shared/error_messages', resource: resource %>

      <!-- Email -->
      <div>
        <%=
          f.email_field :email,
                        autofocus: true,
                        autocomplete: 'email',
                        placeholder: 'Email',
                        class:
                          'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-500'
        %>
      </div>

      <!-- Password -->
      <div>
        <%=
          f.password_field :password,
                           autocomplete: 'new-password',
                           placeholder: 'Password',
                           class:
                             'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-500'
        %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-500 mt-1">
            Minimum
            <%= @minimum_password_length %>
            characters
          </p>
        <% end %>
      </div>

      <!-- Password Confirmation -->
      <div>
        <%=
          f.password_field :password_confirmation,
                           autocomplete: 'new-password',
                           placeholder: 'Confirm Password',
                           class:
                             'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-500'
        %>
      </div>

      <!-- Submit -->
      <div>
        <%=
          f.submit 'Sign up',
                   class:
                     'w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 rounded-md transition'
        %>
      </div>
    <% end %>

    <!-- Links -->
    <div class="mt-6 text-center text-sm text-gray-500">
      <%= render 'devise/shared/links' %>
    </div>
  </div>
</div>
