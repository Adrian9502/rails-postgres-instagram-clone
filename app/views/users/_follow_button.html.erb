<div id="follow_button_<%= user.id %>">
  <% if current_user == user %>
    <!-- Don't show follow button for own profile -->
  <% elsif is_following %>
    <%
      follow = current_user.follows_as_follower.find_by(followed_id: user.id)
    %>
    <%= button_to follow_path(follow), method: :delete, class: "px-4 py-2 text-sm text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-md transition font-semibold" do %>
      Following
    <% end %>
  <% else %>
    <%= button_to follows_path, method: :post, params: { followed_id: user.id }, class: "px-4 py-2 text-sm text-white bg-blue-500 hover:bg-blue-600 rounded-md transition font-semibold" do %>
      Follow
    <% end %>
  <% end %>
</div>
