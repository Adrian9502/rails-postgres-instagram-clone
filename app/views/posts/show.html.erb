<% content_for :title, 'Post Details' %>

<div class="max-w-4xl mx-auto">
  <!-- Notice Message -->
  <% if notice.present? %>
    <div
      class="mb-6 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm"
      id="notice"
    >
      <%= notice %>
    </div>
  <% end %>

  <!-- Post Content Card -->
  <div
    class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden"
  >
    <%= render @post %>
  </div>

  <!-- Action Buttons -->
  <div class="mt-6 flex flex-wrap gap-3">
    <%= link_to edit_post_path(@post), class: 'flex-1 sm:flex-initial px-6 py-2.5 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition text-center inline-flex items-center justify-center gap-2' do %>
      <i class="fas fa-edit"></i>
      <span>Edit Post</span>
    <% end %>

    <%= link_to posts_path, class: 'flex-1 sm:flex-initial px-6 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition text-center inline-flex items-center justify-center gap-2' do %>
      <i class="fas fa-arrow-left"></i>
      <span>Back to Posts</span>
    <% end %>

    <%= button_to @post, method: :delete, data: { turbo_confirm: 'Are you sure you want to delete this post? This action cannot be undone!' }, class: 'flex-1 sm:flex-initial px-6 py-2.5 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg transition inline-flex items-center justify-center gap-2' do %>
      <i class="fas fa-trash-alt"></i>
      <span>Delete Post</span>
    <% end %>
  </div>
</div>
