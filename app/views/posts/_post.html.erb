<%= link_to post_path(post), class: "block my-5 p-5 text-center space-y-3 cursor-pointer rounded-md hover:shadow-lg transition mx-auto max-w-3xl" do %>
  <!-- Post Title -->
  <div class="font-bold text-2xl mb-2"><%= post.title %></div>

  <!-- Post Description -->
  <div class="text-gray-700 text-md mb-3"><%= post.description %></div>

  <!-- Images Section -->
  <% if post.images.attached? %>
    <% images = post.images.limit(3) %> <!-- limit to 3 images -->
    <div class="flex flex-wrap justify-center gap-3 my-3">
      <% images.each_with_index do |image, index| %>
        <%= image_tag image, class: "w-[200px] h-[400px] object-cover rounded-md" %>
      <% end %>
    </div>
  <% end %>

  <!-- Keywords -->
  <div class="text-gray-500 text-sm"><%= post.keywords %></div>
<% end %>

