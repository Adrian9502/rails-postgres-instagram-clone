<% content_for :title, 'Posts Feed' %>

<div class="max-w-xl mx-auto px-4 py-6 space-y-6">
  <% if @posts.any? %>
    <% @posts.each do |post| %>
      <div class="bg-white border border-gray-300 rounded-lg overflow-hidden">
        <!-- Post Header -->
        <div
          class="flex items-center justify-between px-4 py-3 border-b border-gray-200"
        >
          <%= link_to user_path(post.user), class: "flex items-center gap-3" do %>
            <div
              class="w-8 h-8 rounded-full bg-gradient-to-tr from-yellow-400 via-red-500 to-purple-500 p-0.5"
            >
              <div
                class="w-full h-full rounded-full bg-white flex items-center justify-center"
              >
                <span class="text-xs font-semibold text-gray-700">
                  <%=
                    post.user&.username&.first&.upcase ||
                      post.user&.email&.first&.upcase || 'U'
                  %>
                </span>
              </div>
            </div>
            <div>
              <p class="font-semibold text-sm">
                <%=
                  post.user&.username || post.user&.email&.split('@')&.first ||
                    'User'
                %>
              </p>
              <p class="text-xs text-gray-500">
                <%= time_ago_in_words(post.created_at) %> ago
              </p>
            </div>
          <% end %>

          <!-- Follow button in feed -->
          <% if current_user != post.user %>
            <% is_following = current_user.following.include?(post.user) %>
            <%=
              render partial: 'users/follow_button',
                     locals: {
                       user: post.user,
                       is_following: is_following,
                     }
            %>
          <% end %>
        </div>

        <!-- Caption -->
        <div class="text-sm mb-1 px-4 py-3">
          <span class="font-semibold mr-2 block">
            <%= post.title %>
          </span>
          <span><%= truncate(post.description, length: 100) %></span>
        </div>

        <!-- Post Images -->
        <%= link_to post_path(post) do %>
          <% if post.images.attached? %>
            <div class="w-full">
              <%=
                image_tag post.images.first,
                          class: 'w-full h-auto object-cover max-h-[600px]'
              %>
            </div>
          <% else %>
            <div
              class="w-full h-64 bg-gray-100 flex items-center justify-center"
            >
              <span class="text-gray-400">No image</span>
            </div>
          <% end %>
        <% end %>

        <!-- Post Actions -->
        <div class="px-4 py-3">
          <%=
            render partial: 'posts/like_section',
                   locals: {
                     post: post,
                     liked: current_user.likes.exists?(post_id: post.id),
                   }
          %>

          <!-- View comments link -->
          <% if post.comments.any? %>
            <%=
              link_to "View all #{post.comments.count} comments",
                      post_path(post),
                      class: 'text-sm text-gray-500 hover:text-gray-700 block'
            %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-12">
      <p class="text-gray-500 text-lg mb-4">No posts yet</p>
      <%=
        link_to 'Create your first post',
                new_post_path,
                class:
                  'inline-block px-6 py-3 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition'
      %>
    </div>
  <% end %>
</div>
