<% content_for :title, 'Post Details' %>

<div class="max-w-xl mx-auto px-4 py-6">
  <!-- Notice Message -->
  <% if notice.present? %>
    <div
      class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm"
      id="notice"
    >
      <%= notice %>
    </div>
  <% end %>

  <!-- Post Card - Instagram Style -->
  <div class="bg-white border border-gray-300 rounded-lg overflow-hidden mb-6">
    <!-- Post Header -->
    <div
      class="flex items-center justify-between px-4 py-3 border-b border-gray-200"
    >
      <div class="flex items-center gap-3">
        <div
          class="w-8 h-8 rounded-full bg-linear-to-tr from-yellow-400 via-red-500 to-purple-500 p-0.5"
        >
          <div
            class="w-full h-full rounded-full bg-white flex items-center justify-center"
          >
            <span class="text-xs font-semibold text-gray-700"><%=
                @post.user&.email&.first&.upcase || 'U'
              %></span>
          </div>
        </div>
        <div>
          <p class="font-semibold text-sm">
            <%= @post.user&.email&.split('@')&.first || 'User' %>
          </p>
          <p class="text-xs text-gray-500">
            <%= time_ago_in_words(@post.created_at) %> ago
          </p>
        </div>
      </div>
      <div class="relative">
        <button class="text-gray-700 hover:text-gray-900">
          <i class="fas fa-ellipsis-h"></i>
        </button>
      </div>
    </div>

    <!-- Post Content -->
    <%= render @post %>

    <!-- Post Actions -->
    <div class="px-4 py-3 border-t border-gray-200">
      <div class="flex items-center gap-4 mb-3">
        <button class="hover:text-gray-500 transition">
          <i class="far fa-heart text-2xl"></i>
        </button>
        <button class="hover:text-gray-500 transition">
          <i class="far fa-comment text-2xl"></i>
        </button>
        <button class="hover:text-gray-500 transition">
          <i class="far fa-paper-plane text-2xl"></i>
        </button>
        <button class="ml-auto hover:text-gray-500 transition">
          <i class="far fa-bookmark text-2xl"></i>
        </button>
      </div>

      <!-- Likes count (you can add this if you have likes) -->
      <div class="mb-2">
        <p class="font-semibold text-sm">0 likes</p>
      </div>
    </div>

    <!-- Comments Section -->
    <div class="px-4 pb-3 max-h-96 overflow-y-auto">
      <% if @post.comments.any? %>
        <% @post.comments.where.not(user_id: [nil, ""]).order(created_at: :desc).each do |comment| %>
          <div class="mb-3 flex items-start justify-between group">
            <div class="flex-1">
              <p class="text-sm">
                <span class="font-semibold mr-2">
                  <%= comment.user&.email&.split('@')&.first || 'User' %>
                </span>
                <span class="text-gray-800"><%= comment.text %></span>
              </p>
              <p class="text-xs text-gray-500 mt-1">
                <%= time_ago_in_words(comment.created_at) %> ago
              </p>
            </div>

            <!-- Delete comment button (only show to comment owner) -->
            <% if current_user && comment.user_id.to_s == current_user.id.to_s %>
              <%= button_to comment_path(comment), 
                method: :delete, 
                data: { turbo_confirm: 'Delete this comment?' },
                class: 'opacity-0 group-hover:opacity-100 transition-opacity ml-2 text-gray-400 hover:text-red-600' do %>
                <i class="fas fa-trash text-xs"></i>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-500 text-center py-4">
          No comments yet. Be the first to comment!
        </p>
      <% end %>
    </div>

    <!-- Add Comment Form -->
    <div class="border-t border-gray-200 px-4 py-3">
      <%= form_with(model: @comment, class: "flex items-center gap-3") do |form| %>
        <%= form.hidden_field :post_id, value: @post.id %>

        <button type="button" class="text-2xl hover:text-gray-500 transition">
          <i class="far fa-smile"></i>
        </button>

        <%=
          form.text_field :text,
                          placeholder: 'Add a comment...',
                          class:
                            'flex-1 outline-none text-sm placeholder-gray-400',
                          required: true
        %>

        <%=
          form.submit 'Post',
                      class:
                        'text-blue-500 font-semibold text-sm hover:text-blue-700 cursor-pointer bg-transparent border-0'
        %>
      <% end %>
    </div>
  </div>

  <!-- Action Buttons (Admin/Owner actions) -->
  <div class="flex gap-2 justify-center">
    <%= link_to posts_path, class: 'px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg transition inline-flex items-center gap-2' do %>
      <i class="fas fa-arrow-left text-xs"></i>
      <span>Back</span>
    <% end %>

    <%= link_to edit_post_path(@post), class: 'px-4 py-2 text-sm text-blue-600 hover:bg-blue-50 rounded-lg transition inline-flex items-center gap-2' do %>
      <i class="fas fa-edit text-xs"></i>
      <span>Edit</span>
    <% end %>

    <%= button_to @post, method: :delete, data: { turbo_confirm: 'Delete this post?' }, class: 'px-4 py-2 text-sm text-red-600 hover:bg-red-50 rounded-lg transition inline-flex items-center gap-2' do %>
      <i class="fas fa-trash-alt text-xs"></i>
      <span>Delete</span>
    <% end %>
  </div>
</div>
