<div id="like_section_<%= post.id %>">
  <!-- Like Button -->
  <div class="flex items-center gap-4 mb-2">
    <% if liked %>
      <% user_like = current_user.likes.find_by(post_id: post.id) %>
      <%= button_to like_path(user_like), method: :delete, class: "hover:opacity-60 transition border-0 bg-transparent p-0 cursor-pointer" do %>
        <i class="fas fa-heart text-2xl text-red-500"></i>
      <% end %>
    <% else %>
      <%= form_with(model: Like.new, url: likes_path, method: :post, class: "inline") do |form| %>
        <%= form.hidden_field :post_id, value: post.id %>
        <%= button_tag type: "submit", class: "hover:opacity-60 transition border-0 bg-transparent p-0 cursor-pointer" do %>
          <i class="far fa-heart text-2xl"></i>
        <% end %>
      <% end %>
    <% end %>

    <%= link_to post_path(post), class: "hover:opacity-60 transition" do %>
      <i class="far fa-comment text-2xl"></i>
    <% end %>
  </div>

  <!-- Likes count - NOW INSIDE the turbo-replaced section -->
  <p class="font-semibold text-sm mb-2">
    <%= post.likes.count %> <%= 'like'.pluralize(post.likes.count) %>
  </p>
</div>
